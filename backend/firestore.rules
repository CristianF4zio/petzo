rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== FUNCIONES AUXILIARES ====================
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verificar si el usuario es el propietario del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Verificar si el usuario es el propietario de una mascota
    function isPetOwner(petId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }
    
    // ==================== COLECCIÓN: USERS ====================
    match /users/{userId} {
      // Los usuarios solo pueden leer y escribir su propio documento
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // No permitir eliminación directa
    }
    
    // ==================== COLECCIÓN: PETS ====================
    match /pets/{petId} {
      // Todos pueden leer mascotas disponibles
      allow read: if true;
      
      // Solo usuarios autenticados pueden crear mascotas
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Solo el propietario puede actualizar su mascota
      allow update: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
      
      // Solo el propietario puede eliminar su mascota
      allow delete: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
    }
    
    // ==================== COLECCIÓN: FAVORITES ====================
    match /favorites/{favoriteId} {
      // Los usuarios solo pueden leer sus propios favoritos
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Los usuarios solo pueden crear sus propios favoritos
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Los usuarios solo pueden eliminar sus propios favoritos
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // No permitir actualización
      allow update: if false;
    }
    
    // ==================== COLECCIÓN: ADOPTION_REQUESTS ====================
    match /adoptionRequests/{requestId} {
      // Los usuarios pueden leer sus propias solicitudes o las de sus mascotas
      allow read: if isAuthenticated() && 
                     (resource.data.requesterId == request.auth.uid || 
                      resource.data.ownerId == request.auth.uid);
      
      // Cualquier usuario autenticado puede crear una solicitud
      allow create: if isAuthenticated() && 
                       request.resource.data.requesterId == request.auth.uid;
      
      // Solo el propietario de la mascota puede actualizar el estado
      allow update: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid &&
                       // Solo permitir cambiar el campo 'status'
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt']);
      
      // No permitir eliminación (solo cancelar cambiando status)
      allow delete: if false;
    }
    
    // ==================== COLECCIÓN: MESSAGES ====================
    match /messages/{messageId} {
      // Los usuarios solo pueden leer mensajes donde son remitente o receptor
      allow read: if isAuthenticated() && 
                     (resource.data.senderId == request.auth.uid || 
                      resource.data.receiverId == request.auth.uid);
      
      // Los usuarios solo pueden crear mensajes donde son el remitente
      allow create: if isAuthenticated() && 
                       request.resource.data.senderId == request.auth.uid;
      
      // Los usuarios solo pueden actualizar sus propios mensajes (marcar como leído)
      allow update: if isAuthenticated() && 
                       resource.data.receiverId == request.auth.uid &&
                       // Solo permitir cambiar el campo 'read'
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // No permitir eliminación
      allow delete: if false;
    }
    
    // ==================== COLECCIÓN: CONVERSATIONS ====================
    match /conversations/{conversationId} {
      // Los usuarios solo pueden leer conversaciones donde participan
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.participants;
      
      // Los usuarios solo pueden crear conversaciones donde participan
      allow create: if isAuthenticated() && 
                       request.auth.uid in request.resource.data.participants;
      
      // Los usuarios solo pueden actualizar conversaciones donde participan
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      // No permitir eliminación
      allow delete: if false;
    }
    
    // ==================== COLECCIÓN: NOTIFICATIONS ====================
    match /notifications/{notificationId} {
      // Los usuarios solo pueden leer sus propias notificaciones
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Solo el sistema puede crear notificaciones (backend)
      allow create: if false;
      
      // Los usuarios solo pueden actualizar sus propias notificaciones (marcar como leída)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       // Solo permitir cambiar el campo 'read'
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // Los usuarios solo pueden eliminar sus propias notificaciones
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // ==================== COLECCIÓN: REPORTS ====================
    match /reports/{reportId} {
      // Los usuarios solo pueden leer sus propios reportes
      allow read: if isAuthenticated() && 
                     resource.data.reporterId == request.auth.uid;
      
      // Los usuarios pueden crear sus propios reportes
      allow create: if isAuthenticated() && 
                       request.resource.data.reporterId == request.auth.uid;
      
      // Solo administradores pueden actualizar reportes (verificado en backend)
      allow update: if false;
      
      // No permitir eliminación
      allow delete: if false;
    }
  }
}